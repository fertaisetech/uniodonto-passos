# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

# Integracao com Google Sheets Backend (Server-to-Server)
GOOGLE_PROJECT_ID="your_project_id"
GOOGLE_CLIENT_EMAIL="your_service_account_email@developer.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="your_private_key"
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id"
GOOGLE_MONTHLY_SHEET_NAME="monthly_dashboard"
GOOGLE_SHEET_CACHE_TTL=60

# Segurança do painel
VITE_SECURITY_API_KEY="coloque_a_chave_real_aqui"
