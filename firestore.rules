rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUniodontoUser() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email.matches("^.*@uniodonto\\.com$")
          || request.auth.token.email == "fertaisetech@gmail.com");
    }

    function isPortalAdmin() {
      return isSignedIn()
        && (request.auth.token.email == "fertaisetech@gmail.com"
          || request.auth.token.email == "admin@uniodonto.com");
    }

    match /accounts/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }

    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isPortalAdmin();
      allow create, update: if (isSignedIn() && request.auth.uid == uid) || isPortalAdmin();
      allow delete: if isPortalAdmin();
    }

    match /organizations/uniodonto/months/{monthId} {
      allow read, write: if isUniodontoUser();
    }

    match /organizations/uniodonto/teamMembers/{memberId} {
      allow read: if isUniodontoUser();
      allow create, update, delete: if isPortalAdmin();
    }

    match /organizations/uniodonto/teamCredentials/{memberId} {
      allow read, create, update, delete: if isPortalAdmin();
    }

    match /organizations/uniodonto/roleScreens/{roleId} {
      allow read: if isUniodontoUser();
      allow create, update, delete: if isPortalAdmin();
    }

    match /organizations/uniodonto/consents/{consentId} {
      allow read: if isPortalAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
